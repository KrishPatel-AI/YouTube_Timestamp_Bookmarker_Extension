{
  "manifest_version": 3,
  "name": "YouTube Timestamp Navigator & Bookmark Manager",
  "version": "1.0",
  "description": "Bookmark and navigate to specific moments in YouTube videos instantly",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "Image/image-16.jpg",
    "24": "Image/image-24.jpg",
    "32": "Image/image-32.jpg",
    "64": "Image/image-64.jpg"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}